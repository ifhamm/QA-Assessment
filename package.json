{
  "name": "mock-interview",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test --project=setup --project=authenticated --project=chromium",
    "test:smoke": "playwright test --project=setup --project=authenticated --project=chromium --grep @smoke",
    "test:regression": "playwright test --project=chromium --grep-invert @smoke --no-deps",
    "test:ui": "playwright test tests/ui",
    "test:ui:functional": "playwright test tests/ui/ui-functional.spec.ts",
    "test:cross": "playwright test tests/cross-layer/cross-layer.spec.ts",
    "test:api": "newman run postman/conduit.postman_collection.json --env-var baseUrl=https://api.realworld.show",
    "test:api:local": "newman run postman/conduit.postman_collection.json --env-var baseUrl=http://localhost:3000",
    "test:api:local:ci": "newman run postman/conduit.postman_collection.json --env-var baseUrl=http://localhost:3000 --reporters cli,json --reporter-json-export test-results/newman.json",
    "test:visual": "npm run test:visual:linux",
    "test:visual:linux": "docker compose --profile visual run --rm visual",
    "test:visual:linux:update": "docker compose --profile visual run --rm visual node node_modules/@playwright/test/cli.js test --project=visual --update-snapshots",
    "report:merge": "playwright merge-reports -c playwright.merge.config.ts",
    "ci:summary": "node scripts/ci-summary.mjs",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down -v --remove-orphans",
    "test:local": "cross-env BASE_URL=http://localhost:8081 API_BASE_URL=http://localhost:8081/api AUTH_EMAIL= AUTH_PASSWORD= playwright test --project=setup --project=authenticated --project=chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:tags": "node scripts/check-test-tags.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "newman": "^6.2.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
