{
  "name": "mock-interview",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test tests/ui",
    "test:ui:functional": "playwright test tests/ui/ui-functional.spec.ts",
    "test:cross": "playwright test tests/cross-layer/cross-layer.spec.ts",
    "test:api": "newman run postman/conduit.postman_collection.json --env-var baseUrl=https://api.realworld.show",
    "test:api:local": "newman run postman/conduit.postman_collection.json --env-var baseUrl=http://localhost:3000",
    "test:visual": "playwright test tests/visual",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down -v --remove-orphans",
    "test:local": "cross-env BASE_URL=http://localhost:8081 API_BASE_URL=http://localhost:8081/api AUTH_EMAIL= AUTH_PASSWORD= playwright test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
