# Copy this file to .env and adjust if needed.
# .env is ignored by Git; never commit real credentials.

BASE_URL=https://demo.realworld.show
API_BASE_URL=https://api.realworld.show/api

# Optional. Used by tests/auth.setup.ts to create the authenticated storage
# state. If these credentials are absent or do not authenticate, the setup
# project creates a session-local user instead and writes that storage state.
AUTH_EMAIL=your-email@example.com
AUTH_PASSWORD=your-password
