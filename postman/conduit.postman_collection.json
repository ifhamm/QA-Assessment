  "item": [
    {
      "name": "Register User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const runId = pm.variables.replaceIn('{{$randomUUID}}');\r",
              "\r",
              "pm.collectionVariables.set(\r",
              "    \"ownerUsername\",\r",
              "    `owner_${runId}`\r",
              ");\r",
              "\r",
              "pm.collectionVariables.set(\r",
              "    \"ownerEmail\",\r",
              "    `owner_${runId}@example.com`\r",
              ");"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();\r",
              "\r",
              "pm.test(\"Registration returns expected status\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Response contains user\", function () {\r",
              "    pm.expect(json.user).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"Username matches submitted username\", function () {\r",
              "    pm.expect(json.user.username)\r",
              "        .to.eql(pm.variables.get(\"ownerUsername\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Email matches submitted email\", function () {\r",
              "    pm.expect(json.user.email)\r",
              "        .to.eql(pm.variables.get(\"ownerEmail\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Registration returns a token\", function () {\r",
              "    pm.expect(json.user.token)\r",
              "        .to.be.a(\"string\")\r",
              "        .and.not.be.empty;\r",
              "});\r",
              "\r",
              "pm.collectionVariables.set(\"ownerToken\",json.user.token);\r",
              "pm.collectionVariables.set(\"ownerEmail\", json.user.email);\r",
              "pm.collectionVariables.set(\"ownerUsername\", json.user.username);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"user\": {\r\n    \"username\": \"{{ownerUsername}}\",\r\n    \"email\": \"{{ownerEmail}}\",\r\n    \"password\": \"{{password}}\"\r\n  }\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        }
      },
      "response": []
    },
