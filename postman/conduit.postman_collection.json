              "});\r",
              "\r",
              "pm.test(\"Description matches submitted value\", function () {\r",
              "    pm.expect(json.article.description)\r",
              "        .to.eql(pm.collectionVariables.get(\"articleDescription\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Body matches submitted value\", function () {\r",
              "    pm.expect(json.article.body)\r",
              "        .to.eql(pm.collectionVariables.get(\"articleBody\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Article is created by authenticated user\", function () {\r",
