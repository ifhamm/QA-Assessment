          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();\r",
              "\r",
              "pm.test(\"Create Article returns 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
